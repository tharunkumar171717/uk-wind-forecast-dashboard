# Supabase Postgres (Session pooler URI). Never commit the real value.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
CORS_ORIGINS=http://localhost:5173
FORECAST_CUTOFF_TIME=10:00
FORECAST_CUTOFF_DAYS_BEFORE=1
# live = read from DATABASE_URL; demo = deterministic synthetic data (clearly labelled, never Elexon)
DATA_MODE=live
MAPE_MIN_ACTUAL_MW=1000
CACHE_TTL_SECONDS=600
